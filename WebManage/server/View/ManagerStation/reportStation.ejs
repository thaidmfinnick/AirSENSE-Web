        function exportReport() {
            var fromTime = new Date($('#fromTime').val());
            const getFromTime = fromTime.getTime();
            var toTime = new Date($('#toTime').val());
            const getToTime = toTime.getTime();
            var station_id = document.getElementById("selectTable").value;
            if(!station_id) {
                alert("Vui lòng chọn trạm để xuất báo cáo");
                return;
            }
            if(isNaN(fromTime.getFullYear())) {
                fromTime = undefined;
            } else fromTime = fromTime.getFullYear() +'-'+ fromTime.getMonth() +'-'+ fromTime.getDate() +' '+ fromTime.getHours() +':'+ fromTime.getMinutes() +':00';
            if(isNaN(toTime.getFullYear())) {
                toTime = undefined;
            } else toTime = toTime.getFullYear() +'-'+ toTime.getMonth() +'-'+ toTime.getDate() +' '+ toTime.getHours() +':'+ toTime.getMinutes() +':00';            
            var data = {'fromTime': fromTime, 'toTime': toTime, 'station_id': station_id};
            var link = '/api/social/getReportStations';
            console.log(data)
            $.ajax({
                    type: 'post',
                    method: 'POST',
                    url: link,
                    data: JSON.stringify( {station_id: station_id, fromTime: fromTime, toTime: toTime, getFromTime: getFromTime, getToTime: getToTime}),
                    cache: 'no-cache', // *default, no-cache, reload, force-cache, only-if-cached
                        credentials: 'same-origin', // include, *same-origin, omit
                        redirect: 'follow', // manual, *follow, error
                        referrerPolicy: 'no-referrer', // no-referrer, *no-referrer-when-downgrade, origin, origin-when-cross-origin, same-origin, strict-origin, strict-origin-when-cross-origin, unsafe-url
                        dataType: 'json',
                        cache: 'no-cache', // *default, no-cache, reload, force-cache, only-if-cached
                        credentials: 'same-origin', // include, *same-origin, omit
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                            'Content-Type': 'application/json',
                            'Authorization': 'Beard ' + mname,
                            // 'Content-Type': 'application/x-www-form-urlencoded',
                        },
                    success: function(result) {
                        // console.log(result.slice(8));
                        console.log(result);
                        const nameExcel = result.filePath.slice(8);
                        assetDataBase(result.data)
                        window.location = 'http://localhost:3000' + nameExcel;

                    }
                })

        }



