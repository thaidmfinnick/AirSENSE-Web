    <script type="text/javascript">
        // var dataView = 
        var linkAcess =
         'http://' + window.location.hostname +':' +window.location.port;
        // document.getElementById("htmlToView").src = linkAcess;
        console.log(linkAcess);
        function setItemFormITem(item){
            var html=' <div class="div-image-hust-tech ">  <img class="image-hust-tech" src ="'+item.content_img+'"/>'
                        +'</div>' 
                        +'<div class="div-home-hust-tech"> <label class="div-font1-hust-tech" >'
                        +item.title+'</label><br/> <label class="div-font2-hust-tech" >'
                        +item.content+ '</label> </div>' ;
            return html;
            
        }


         function setFormToShow(item,valueStart,valueEnd,itemHtml){
           var htmlDetail =  '';
           var itemCurent =item.filter(o => (o.group_content_sub_id>valueStart&&o.group_content_sub_id<valueEnd));
           for(var i=0;i<itemCurent.length;i++){
                if(itemCurent[i].is_main_pages_id==-1){
                        htmlDetail += '<div class="title-menu-hust-tech" > <a href="'+linkAcess+'/group_page/' +itemCurent[i].pages_content_id +'"> ' + setItemFormITem(itemCurent[i]) +'</a> </div>'; 
                }
                else
                {
                        htmlDetail += '<div class="title-menu-hust-tech" >  <a href="'+linkAcess +'/detail_page/' +itemCurent[i].filesave +'"> ' + setItemFormITem(itemCurent[i])  +'</a> </div>'; 
                }
                console.log("htmlDetail" ,itemCurent[i],htmlDetail);
           }
           $(itemHtml).html(htmlDetail); 
         }
     
     
     
         $.ajax({
              type: 'GET',
              enctype: 'multipart/form-data',
              url: '/api/document/get_new',
              data: {},
              processData: false, //prevent jQuery from automatically transforming the data into a query string
              contentType: false,
              cache: false,
              success: (data) => {
              console.log(data);
                 var dataJson = JSON.parse(data);
                 console.log(dataJson);
                 setFormToShow(dataJson,0,9,"#tech_description");
                 setFormToShow(dataJson,20,29,"#documnet_description");
                 setFormToShow(dataJson,30,39,"#cum_description");
                 setFormToShow(dataJson,40,49,"#tool_view_data");
              },
              error: (e) => {
                console.log(e.responseText);
              },
          });
       </script>

