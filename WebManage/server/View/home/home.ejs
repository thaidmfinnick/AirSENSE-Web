<head>
    <style>
/* Slideshow styling */
.carousel-item {
  transition: transform 1s ease, opacity 1s ease-out;
}

.carousel {
    margin-top: 72px;
  margin-bottom: 60px;
}
/* Khoá học styling */

.course-box {
  padding-left: 20px;
  padding-right: 20px;
}

.course-box-content {
  width: 100%;
  display: flex;
  overflow-y: hidden;
  overflow-x: auto;
}

/*Heading Khoá học*/
.course-heading {
  margin-top: 30px;
}

/* Scrollbar styling */
.course-box-content::-webkit-scrollbar {
  height: 8px;
}

/* Track */
.course-box-content::-webkit-scrollbar-track {
  background: #f1f1f1;
}

/* Handle */
.course-box-content::-webkit-scrollbar-thumb {
  background: #888;
  border-radius: 5px;
}

/* Handle on hover */
.course-box-content::-webkit-scrollbar-thumb:hover {
  background: #555;
}

.card-box {
  width: 18rem;
  margin: 20px 20px 20px 0;
}

.card {
  margin-right: 20px;
  border-radius: 10px;
}

.card-img-top {
  border-top-left-radius: 10px;
  border-top-right-radius: 10px;
}

.card-title {
  margin-bottom: 15px;
}

/*Blog*/
.blog-heading-box {
  text-align: center;
}

.blog-box-home {
  width: 100%;
  display: flex;
  overflow-y: hidden;
  overflow-x: auto;
  padding-left: 20px;
  padding-right: 20px;
}

.blog-heading-home {
  margin-top: 30px;
}

.blog-box {
  width: 100%;
}

.blog-carousel-item {
  width: 33%;
  display: inline-block;
  text-align: center;
}

/*Tai sao chon chung toi*/
.why-box {
  background-color: #27e450;
  padding: 50px 0 50px 0;
}

.why-heading {
  color: white;
}

.why-box-heading {
  text-align: center;
}

.why-box-content {
  display: inline-flex;
  margin-top: 20px;
  text-align: justify;
  align-items: center;
  padding-left: 25%;
}

.why-text {
  width: 60%;
  padding-left: 20px;
  padding-right: 20px;
}

/*Thong tin lien he*/
.contact-customer {
  padding: 50px 0 50px;
  text-align: center;
  background-color: #ededed;
}
.contact-heading {
  margin-bottom: 20px;
}

.contact-info-form {
  margin-top: 20px;
  display: inline-block;
  width: 100%;
  margin-bottom: 20px;
}

.form-content {
  display: inline-flex;
  align-items: baseline;
}

.input-group {
  width: 50%;
  margin-left: 25%;
}

.input-email {
  border-color: #27e450;
}

.icon-contact-customer {
  margin-left: 20px;
}

.icon-contact-customer:hover {
  cursor: pointer;
}
/*Doi tac*/
.doitac {
  text-align: center;
  padding: 50px 0 50px 0;
}

.image-placeholder {
  text-align: center;
  padding: 20px 0 20px 0;
}

    </style>
</head>
