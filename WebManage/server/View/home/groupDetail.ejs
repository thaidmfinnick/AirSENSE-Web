<!DOCTYPE html>
<html lang="zxx">
  <% include ../Layout/header.ejs %>
  <body class="defult-home">
    <!-- Main content Start -->
    <div class="main-content">
      <!--Full width header Start-->
      <div class="full-width-header home8-style4">
        <!--Header Start-->
        <% include ../Layout/headerMenu.ejs %>
        <!--Header End-->
      </div>
      <!--Full width header End-->
      <div class="main-page">
        <% include ../Layout/sideMenuAd.ejs %>
        <div class="inner-content">
          <!-- About Section Start -->
          <div class="rs-about style9 pt-40 md-pt-70">
            <div class="container">
              <br/>
              <div class="row" 
                  style = "display: flex; flex-direction: column;"
                  id="htmlToView">
              </div>
              <br/>
            </div>
          </div>
        </div>
        <% include ../Layout/advertisement.ejs %>
        <!-- About Section End -->
      </div>
      <% include ../Layout/footer.ejs %>

      <!-- Categories Section End -->
    </div>
    <!-- Main content End -->
  </body>
  <script type="text/javascript">
      var dataView = '<%= detail %>';
      console.log("dataView dataView dataView",dataView);
      var linkAcess =
         'http://' + window.location.hostname +':' +window.location.port ;
      var linkAcessDetail =
         'http://' + window.location.hostname +':' +window.location.port + '/api/document/group_page';

      function getContentHtml(linkData){
        console.log(linkAcess);
        $.ajax({
              type: 'GET',
              enctype: 'multipart/form-data',
              url: linkData,
              data: {},
              processData: false, //prevent jQuery from automatically transforming the data into a query string
              contentType: false,
              cache: false,
              success: (data) => {
              console.log(data);
                $('#htmlToView').html(data); //.replaceAll("</p>","<br/>").replaceAll("<p>","<br/>")
                  $('html, body').animate({ scrollTop: 0 }, 'fast');
              },
              error: (e) => {
                console.log(e.responseText);
              },
          });
      }

      var dataViewLstLink=[];
      function getAllContenHtml(lstData){
          var htmlData="";
          var headHtml="";
          dataViewLstLink= lstData;
          for(var i=0;i<lstData.length;i++){
            let valueData = lstData[i];
            var tilteAdd="";
            if(i!=0)  tilteAdd = '<span class="div-properties-dot"></span>';
            if(valueData.pages_content_id!=dataView)
                htmlData+= '<a class="side-menu-item" onclick="loadDataPage('+i+')"> ' + tilteAdd+ valueData.title +'</a>';
            else
            {
              headHtml ='<a class="side-menu-item" onclick="loadDataPage('+i+')"> ' + tilteAdd + valueData.title +'</a>';
              loadDataPage(i);
            }
               
          }
         
          //head_data_side_menu
          $("#head_data_side_menu").html(headHtml);
          $("#check_data_side_menu").html(htmlData);
      }


      function loadDataPage(int){
        let valueData = dataViewLstLink[int];
        var link=valueData.filesave.replaceAll('/detail_page/', '/');
        console.log(link);
        var linkAdd= linkAcess + link.replaceAll('+', '/');
        console.log(linkAdd);
        getContentHtml(linkAdd);
      }


      $.ajax({
            type: 'post',
            method: 'POST',
            url: linkAcessDetail,
            body: JSON.stringify({is_main_pages_id:dataView}), // body data type must match "Content-Type" header
            data: JSON.stringify({is_main_pages_id:dataView}), // body data type must match "Content-Type" header
            cache: 'no-cache', // *default, no-cache, reload, force-cache, only-if-cached
            credentials: 'same-origin', // include, *same-origin, omit
            redirect: 'follow', // manual, *follow, error
            referrerPolicy: 'no-referrer', // no-referrer, *no-referrer-when-downgrade, origin, origin-when-cross-origin, same-origin, strict-origin, strict-origin-when-cross-origin, unsafe-url
            dataType: 'json',
            cache: 'no-cache', // *default, no-cache, reload, force-cache, only-if-cached
            credentials: 'same-origin', // include, *same-origin, omit
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
                'Content-Type': 'application/json',
                // 'Content-Type': 'application/x-www-form-urlencoded',
            },
            success: function (dataReturn) {
                console.log(dataReturn);
                getAllContenHtml(dataReturn);
               // $("#detailAcess").html(dataReturn.user.email);
            },
            error: function (loadcofig) {
                console.log(loadcofig);
            }
      });


      
    </script>
</html>
