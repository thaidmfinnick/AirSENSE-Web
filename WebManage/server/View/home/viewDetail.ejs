<!DOCTYPE html>
<html lang="zxx">
  <% include ../Layout/header.ejs %>
  <body class="defult-home">
    <!-- Main content Start -->
    <div class="main-content">
      <!--Full width header Start-->
      <div class="full-width-header home8-style4">
        <!--Header Start-->
        <% include ../Layout/topbar.ejs %>
        <!--Header End-->
      </div>
      <!--Full width header End-->
      <div class="main-page pt-100">
        <div class="inner-content">
          <!-- About Section Start -->
          <div class=" style9 md-pt-100">
            <div class="container" style="height:800px; padding-top: 100px">
              <br/>
              <div class="row" 
                  style = "display: flex; flex-direction: column;"
                  id="htmlToView">
              </div>
              <br/>
            </div>
          </div>
        </div>
        <!-- About Section End -->
      </div>
      <% include ../Layout/footer.ejs %>

      <!-- Categories Section End -->
    </div>
    <!-- Main content End -->
  </body>
  <script type="text/javascript">
       var dataView = '<%= detail %>';
       var linkAcess =
         'http://' + window.location.hostname +':' +window.location.port + '/' +
        dataView.replaceAll('+', '/');
         console.log(linkAcess);
      // document.getElementById("htmlToView").src = linkAcess;

       $.ajax({
            type: 'GET',
            enctype: 'multipart/form-data',
            url: linkAcess,
            data: {},
            processData: false, //prevent jQuery from automatically transforming the data into a query string
            contentType: false,
            cache: false,
            success: (data) => {
            console.log(data);
              $('#htmlToView').html(data); //.replaceAll("</p>","<br/>").replaceAll("<p>","<br/>")
              $('html, body').animate({ scrollTop: 0 }, 'fast');
            },
            error: (e) => {
              console.log(e.responseText);
            },
        });
    </script>
</html>
