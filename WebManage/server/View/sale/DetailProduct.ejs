        <script type="text/javascript">
         var dataView = '<%= detail %>';
                dataView = dataView.replaceAll('type=', '');
            var showData='MÔ Ty laptop.';
            var dataInfo=null;

            $('#homeDescription').html(showData);
            //LINK KIỆN
            var dataJsonPage = {};// 
            console.log(dataJsonPage);
            var numberSelect=0;

            function onChangeLinkClick(link){ 
                $("#main_product_detail").attr("src",dataInfo[link].image );
            }

            function onChangeCostProduct(value){ 
                numberSelect=value;
                $("#cost_value_calculator").html(dataInfo[value].cost_detail);
            }

            var infoDetailProduct = {product_id:parseInt(dataView) ,number:1 ,imageInfo:"" };
            function addValueProduct(){
                 // Get saved data from sessionStorage
                var data = sessionStorage.getItem('cart');
                var dataCart={name:"info",value:[]};
                if(data!=null){
                    dataCart= JSON.parse(data);
                }
                infoDetailProduct.number= parseInt($("#numberProduct").val());
                infoDetailProduct.imageInfo=dataInfo[numberSelect];
                var fillter =dataCart.value.filter(o=>o.imageInfo.image_id==infoDetailProduct.imageInfo.image_id);
                if(fillter.length>0){
                    // đơn hàng tồn tại
                    return;
                }
                dataCart.value.push(infoDetailProduct);
               
               // Save data to sessionStorage
                sessionStorage.setItem('cart', JSON.stringify(dataCart));
                onReload();
            }


            function gotoCheckInfoValue(loadcofig){  
                var typeSupport='<div style="float: left;margin-right: 15px;width:150px;"> kết hợp với </div>';
                var tupeSupportImage='';
                var value_promotion=`<div style="float: left;margin-right: 15px;width:150px;"> Sản phẩm </div>`;
                dataInfo = loadcofig;

                for(var i=0;i<loadcofig.length;i++ ){
                    if(loadcofig[i].detail!=null)
                        $('#name_product_device').html(loadcofig[i].detail);
                    $('#cost_value_calculator').html(loadcofig[i].cost);
                    if(loadcofig[i].cost_percent<100)
                        $('#km_product_detail').html(loadcofig[i].km_product_detail+'%');
                    $('#save_coin_product_detail').html('0 xu');
                    if(loadcofig[i].content_sale_support!=null)
                        typeSupport+='<button class="add_to_cart_button" >' 
                            +loadcofig[i].content_sale_support+'</button>';
                    $('#note_product_detail').html(loadcofig[i].content);

                    if((i==0)&&(loadcofig[i].image!=null)){
                        $("#main_product_detail").attr("src",loadcofig[i].image);
                        tupeSupportImage+=' <img   src="'+loadcofig[i].image +'" onclick="onChangeLinkClick('
                        +i+')" alt="">';
                    }
                    
                    if(loadcofig[i].image_info_detail!=null){
                        tupeSupportImage+=' <img   src="'+loadcofig[i].image_info_detail 
                                            +'" onclick="onChangeLinkClick('+i+')" alt="">';
                    }
                        
                    if(loadcofig[i].name_image_detail!=null){
                        value_promotion +=(`<button class="add_to_cart_button" onclick="onChangeCostProduct(`+
                                            i+`)"  id="km_product_detail" >`
                                            +loadcofig[i].name_image_detail+`</button>`);         
                    }   
                }
  
                $('#type_product_detail').html(typeSupport);
                $('#main_suport_pro_detail').html(tupeSupportImage);
                $('#value_promotion').html(value_promotion);
                            
            }

            $.ajax({
                        type: 'get',
                        method: 'GET',
                        url: ('/api/customers/detail_product?type='+dataView),
                     //   body: JSON.stringify({type:dataView}), // body data type must match "Content-Type" header
                     //   data: JSON.stringify({type:dataView}), // body data type must match "Content-Type" header
                        cache: 'no-cache', // *default, no-cache, reload, force-cache, only-if-cached
                        credentials: 'same-origin', // include, *same-origin, omit
                        redirect: 'follow', // manual, *follow, error
                        referrerPolicy: 'no-referrer', // no-referrer, *no-referrer-when-downgrade, origin, origin-when-cross-origin, same-origin, strict-origin, strict-origin-when-cross-origin, unsafe-url
                        dataType: 'json',
                        cache: 'no-cache', // *default, no-cache, reload, force-cache, only-if-cached
                        credentials: 'same-origin', // include, *same-origin, omit
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                            'Content-Type': 'application/json',
                            // 'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        success: function (data) {
                            console.log(data.result);
                            gotoCheckInfoValue(data.result);
                           
                        // $("#detailAcess").html(dataReturn.user.email);
                        },
                        error: function (loadcofig) {
                            console.log(loadcofig);
                        }
                });
        </script>



