<!DOCTYPE html>

<html lang="en">
    <% include ../Layout/sale/header.ejs %>
    <body>
    <% include ../Layout/sale/menuSale.ejs %>
        <div class="slider-area">
                <!-- Slider -->
                <div class="block-slider block-slider4">
                    <ul class="" id="bxslider-home4">
                        <li>
                            <img src="sale/img/h4-slide.png" alt="Slide">
                            <div class="caption-group">
                                <h2 class="caption title">
                                    iPhone <span class="primary">6 <strong>Plus</strong></span>
                                </h2>
                                <h4 class="caption subtitle">Dual SIM</h4>
                                <a class="caption button-radius" href="#"><span class="icon"></span>Shop now</a>
                            </div>
                        </li>
                    </ul>
                </div>
                <!-- ./Slider -->
        </div> <!-- End slider area -->
        
        <div class="maincontent-area">
            <div class="zigzag-bottom"></div>
            <div class="container">
                <div class="row">
                    <div class="col-md-12">
                        <div class="latest-product">
                            <h2 class="section-title">Các sản phẩm</h2>
                            <div class="product-carousel" id="newProduct" >
                                <div class="single-product">
                                    <div class="product-f-image">
                                        <img src="img/product-1.jpg" class="product-image-size" alt="">
                                        <div class="product-hover">
                                            <a href="#" class="add-to-cart-link"><i class="fa fa-shopping-cart"></i> Add to cart</a>
                                            <a href="single-product.html" class="view-details-link"><i class="fa fa-link"></i> See details</a>
                                        </div>
                                    </div>
                                    
                                    <h2><a href="single-product.html">Samsung Galaxy s5- 2015</a></h2>
                                    
                                    <div class="product-carousel-price">
                                        <ins>$700.00</ins> <del>$100.00</del>
                                    </div> 
                                </div>

                            
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div> <!-- End main content area -->
        
        
        <div class="product-widget-area">
            <div class="zigzag-bottom"></div>
            <div class="container">
                <div class="row">
                    <div class="col-md-4">
                        <div class="single-product-widget" id="infosub1">
                            
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="single-product-widget" id="infosub2">
                            
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="single-product-widget" id="infosub3">
                            
                        </div>
                    </div>
                </div>
            </div>
        </div> <!-- End product widget area -->

        <% include ../Layout/sale/footer.ejs %>
    </body>
    <script type="text/javascript">
            function setFormToShow(items,itemHtml){
                var htmlDetail = "";
                items.forEach(element => {
                    var dataInfor= `<li>
                                    <img src="`+element.content_img+`" alt="Slide"  style="max-height:200px;"" >
                                    <div class="caption-group">
                                        <h2 class="caption title">
                                            `+element.title+` <span class="primary"> `+element.content+`</span>
                                        </h2>
                                        <h4 class="caption subtitle">`+element.title+`</h4>
                                        <a class="caption button-radius" href="/`+element.filesave+`">
                                            <span class="icon"></span>
                                            vào đi thôi
                                        </a>
                                    </div>
                                </li>`;
                    htmlDetail+=dataInfor;
                });  
                console.log(htmlDetail);         
                $(itemHtml).html(htmlDetail); 
                loadSlider();
            }
             
         
            $.ajax({
                  type: 'GET',
                  enctype: 'multipart/form-data',
                  url: '/api/customers/advertisement',
                  data: {},
                  processData: false, //prevent jQuery from automatically transforming the data into a query string
                  contentType: false,
                  cache: false,
                  success: (data) => {
                  console.log(data);
                     setFormToShow(data.result,"#bxslider-home4");
                  },
                  error: (e) => {
                    console.log(e.responseText);
                  },
            });
            var dataSaveInfo={};
            function setNewProduct(item,itemHtml){
                var htmlDetail = "";
                var counter=0;
                dataSaveInfo["main"]=item;
                item.forEach(element => {
                    var dataInfor= `<div class="single-product">
                                        <div class="product-f-image">
                                            <img src="`+element.image+`" class="product-image-size" alt="">
                                            <div class="product-hover">
                                                <a onClick="addProductToCart(1,`+
                                                    element.product_id+`,'main',`+counter+
                                                    `)" class="add-to-cart-link"><i class="fa fa-shopping-cart"></i> Add to cart</a>
                                                <a href="/sale/product_detail?type=`+
                                                    element.product_id+
                                                    `" class="view-details-link"><i class="fa fa-link"></i> See details</a>
                                            </div>
                                        </div>
                                        <h2><a href="/sale/product_detail?type=`+element.product_id+`">`+element.name+`</a></h2>
                                        <div class="product-carousel-price">
                                            <ins>$`+element.cost_detail+`</ins> <del>$`+element.cost_detail+`</del>
                                        </div> 
                                    </div>`;
                    htmlDetail+=dataInfor;
                    counter++
                });  
                console.log(htmlDetail);         
               $(itemHtml).html(htmlDetail);
               initProductCarousel();     
            }
            


            function setFillertProduct(items,itemHtml,name,company_id){
                var htmlDetail = `  <h2 class="product-wid-title">`+name+`</h2>
                                    <a href="" class="wid-view-more">View All</a>`;
                var itemsData=items.filter(o=>o.company_id==company_id);
                itemsData.forEach(element => {
                    var dataInfor= `<div class="single-wid-product">
                                        <a href="/sale/product_detail?type=`+
                                                    element.product_id+`">
                                            <img src="`+element.image+`" alt="" class="product-thumb">
                                        </a>
                                        <h2><a href="/sale/product_detail?type=`+
                                                    element.product_id+`">`+element.name+`</a></h2>
                                        <div class="product-wid-rating">
                                            <i class="fa fa-star"></i>
                                            <i class="fa fa-star"></i>
                                            <i class="fa fa-star"></i>
                                            <i class="fa fa-star"></i>
                                            <i class="fa fa-star"></i>
                                        </div>
                                        <div class="product-wid-price">
                                            <ins>`+element.cost_detail+`</ins> <del>`+element.cost_detail+`</del>
                                        </div>                            
                                    </div>`;
                    htmlDetail+=dataInfor;
                });  
                console.log(htmlDetail);         
               $(itemHtml).html(htmlDetail);
               initProductCarousel();     
            }





            $.ajax({
                  type: 'GET',
                  enctype: 'multipart/form-data',
                  url: '/api/customers/info_product',
                  data: {},
                  processData: false, //prevent jQuery from automatically transforming the data into a query string
                  contentType: false,
                  cache: false,
                  success: (data) => {
                       setNewProduct(data.result,"#newProduct"); //id="infosub1"
                       setFillertProduct(data.result,"#infosub1","IC",3);
                       setFillertProduct(data.result,"#infosub2","Linh kiện",4);
                       setFillertProduct(data.result,"#infosub3","Thiết bị thông minh",5);
                  },
                  error: (e) => {
                    console.log(e.responseText);
                  },
            });
    </script>
</html>