<!DOCTYPE html>

<html lang="en">
    <% include ../Layout/sale/header.ejs %>
    <body>
        <% include ../Layout/sale/menuSale.ejs %>
        <div class="single-product-area">
            <div class="zigzag-bottom"></div>
            <div class="container">
                <div class="row">
    
                    <div class="col-md-8">
                        <div id="mainSelectItem"></div>
                        <div class="product-content-right">
                            <div class="woocommerce">
                                <form method="post" action="/sale/bill">
                                    <table cellspacing="0" class="shop_table cart">
                                        <thead>
                                            <tr>
                                                <th class="product-remove">&nbsp;</th>
                                                <th class="product-thumbnail">&nbsp;</th>
                                                <th class="product-name">Product</th>
                                                <th class="product-price">Price</th>
                                                <th class="product-quantity">Quantity</th>
                                                <th class="product-subtotal">Total</th>
                                            </tr>
                                        </thead>
                                        <tbody id="cart_item_detail">
                                            <tr class="cart_item" >
                                                <td class="product-remove">
                                                    <a title="Remove this item" class="remove" href="#">×</a> 
                                                </td>

                                                <td class="product-thumbnail">
                                                    <a href="single-product.html"><img width="145" height="145" alt="poster_1_up" class="shop_thumbnail" src="/img/product-thumb-2.jpg"></a>
                                                </td>

                                                <td class="product-name">
                                                    <a href="single-product.html">Ship Your Idea</a> 
                                                </td>

                                                <td class="product-price">
                                                    <span class="amount">£15.00</span> 
                                                </td>

                                                <td class="product-quantity">
                                                    <div class="quantity buttons_added">
                                                        <input type="button" class="minus" value="-">
                                                        <input type="number" size="4" class="input-text qty text" title="Qty" value="1" min="0" step="1">
                                                        <input type="button" class="plus" value="+">
                                                    </div>
                                                </td>

                                                <td class="product-subtotal">
                                                    <span class="amount">£15.00</span> 
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="actions" colspan="6">
                                                    <input type="submit" value="Back" name="update_cart" class="button">
                                                    <input type="submit" value="Checkout" name="proceed" class="checkout-button button alt wc-forward">
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    
                                </form>

                                <div class="cart-collaterals">
                                    <div class="cart_totals_checkout ">
                                        <input type="submit" onclick="uploadTheBill()"
                                            value="Checkout" name="proceed" 
                                            class="checkout-button button alt wc-forward">
                                    </div>
                                </div>
                            </div>                        
                        </div>                    
                    </div>
                </div>
            </div>
        </div>
    
        <% include ../Layout/sale/footer.ejs %>

        <script type="text/javascript">

            function onAddOrRemove(id,number,fied){
                var value=$('#'+fied).val()+ number;
                $('#'+fied).val(value);
            }

            function onReload(){
                var data = sessionStorage.getItem('cart');
                var dataCart={name:"info",value:[]};
                if(data!=null){
                    dataCart= JSON.parse(data);
                }
                console.log("onReload ........");
                var costValue=0;
                var numberProduct=dataCart.value.length;
                var htmlInfo=``;
        
                for(var i=0;i<dataCart.value.length;i++){
                    let item =dataCart.value[i];
                    var costSum=item.number* item.imageInfo.cost_detail;
                    costValue += costSum;
                    htmlInfo =htmlInfo + `<tr class="cart_item" > <td class="product-remove">
                                        <a title="Remove this item" class="remove" onclick="onChangeLinkClick(`+i+`)">×</a> 
                                </td>`;
                    htmlInfo =htmlInfo + `<td class="product-thumbnail">
                                        <a href="/sale/product_detail?type=`+item.product_id+`">`
                                            +`<img width="145" height="145" alt="poster_1_up" 
                                        class="shop_thumbnail" src="`+item.imageInfo.image_info_detail+`"></a>
                                </td>
                                <td class="product-name">
                                    <a href="/sale/product_detail?type=`+item.product_id+`">`
                                            +item.imageInfo.name+" - " + item.imageInfo.name_image_detail+`</a> 
                                </td>
                                <td class="product-price">
                                    <span class="amount">£`+item.imageInfo.cost_detail+`</span> 
                                </td>
                                <td class="product-quantity">
                                    <div class="quantity buttons_added">
                                        <input type="button" class="minus" onClick="onAddOrRemove(1,-1,1)"  value="-">
                                        <input type="number" size="4" class="input-text qty text" title="Qty" value="`
                                            +item.number+`" min="0" step="1" >
                                        <input type="button" class="plus" value="+">
                                    </div>
                                </td>
                                <td class="product-subtotal">
                                    <span class="amount">£`+costSum+`</span> 
                                </td> </tr>`;

                }
                htmlInfo =htmlInfo + `<tr>
                                            <td class="actions" colspan="6">
                                                <span class="amount"> Tổng giá trị đơn hàng : £`+costValue+`</span> 
                                            </td>
                                        </tr>`;
                $('#cart_item_detail').html(htmlInfo);
        
            }
            setTimeout(() => {
                onReload();
            }, 2000);
           
            function setupIdCheck(){
                var dataInval=localStorage.getItem('token');
                if((dataInval==null)||(dataInval.length<100)){
                    var itemValue= ["username","email","password","token_reset","phone","avatar","fullname","permission_id","address","note"];
                    var htmlData='';
                    itemValue.forEach(element => {
                        console.log("element ,",element);
                        htmlData  =htmlData + element+  '<input type="text" id="'+element+'" name="'+element+'"><br/>';
                    });
                    alert("xin vui lòng điền thêm thông tin ");
                    console.log("htmlData ,",htmlData);
                    $('#mainSelectItem').html(htmlData);
                    return false;
                }
                return true;
            }
            function checkDataInval(){
                var dataInval=localStorage.getItem('token');
                if((dataInval==null)||(dataInval.length<100)){
                    if(!!!($('#username').val())) return false;
                }
                return true;
            }

            function getDataInval(info){
                var itemValue= ["username","email","password","token_reset","phone","avatar","fullname","permission_id","address","note"];
                var htmlData='';
                itemValue.forEach(element => {
                    console.log("element ,",element);
                    info[element]=$('#'+element).val();
                });
                var costValue=0;
                info.value.forEach(item => {
                    costValue += (item.number* item.imageInfo.cost_detail);
                });
                info['Total']=costValue;
                return info;
            }

            function uploadTheBill(){
                var dataJsonData = sessionStorage.getItem('cart');
                if(!checkDataInval()){
                    setupIdCheck();
                    return;
                }
                var dataJsonnew=getDataInval(JSON.parse(dataJsonData));
                $.ajax({
                        type: 'post',
                        method: 'POST',
                        url: '/api/customers/bill',
                     //   body: JSON.stringify({type:dataView}), // body data type must match "Content-Type" header
                        data: JSON.stringify(dataJsonnew), // body data type must match "Content-Type" header
                        cache: 'no-cache', // *default, no-cache, reload, force-cache, only-if-cached
                        credentials: 'same-origin', // include, *same-origin, omit
                        redirect: 'follow', // manual, *follow, error
                        referrerPolicy: 'no-referrer', // no-referrer, *no-referrer-when-downgrade, origin, origin-when-cross-origin, same-origin, strict-origin, strict-origin-when-cross-origin, unsafe-url
                        dataType: 'json',
                        cache: 'no-cache', // *default, no-cache, reload, force-cache, only-if-cached
                        credentials: 'same-origin', // include, *same-origin, omit
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                            'Content-Type': 'application/json',
                            'Authorization': 'Beard ' + localStorage.getItem('token'),
                            // 'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        success: function (data) {
                            window.location.href = "http://localhost:3000/sale/finish?type="+data.result;
                            console.log(data.result);
                        // $("#detailAcess").html(dataReturn.user.email);
                        },
                        error: function (loadcofig) {
                            console.log(loadcofig);
                        }
                });
            }
        
        </script>
    </body>
</html>