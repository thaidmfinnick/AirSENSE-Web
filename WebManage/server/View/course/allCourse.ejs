  <script>


    const completeScroll = document.querySelector('.js-complete-scroll');
    const completePrevBtn = document.querySelector('.complete-scroll-prev-btn');
    const completeNextBtn = document.querySelector('.complete-scroll-next-btn');
    const completeCourseItem = document.querySelectorAll('.course-complete__item');


    completeNextBtn.onclick = () => {
      completeScroll.scrollLeft += completeScroll.scrollWidth / completeCourseItem.length;
    };
    completePrevBtn.onclick = () => {
      completeScroll.scrollLeft -= completeScroll.scrollWidth / completeCourseItem.length;
    };
  </script>
