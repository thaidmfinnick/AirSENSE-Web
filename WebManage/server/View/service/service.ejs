    <script type="text/javascript">
        function setFormToShow(items,itemHtml){
            var htmlDetail = "";
            items.forEach(element => {
                var dataInfor= `<li> <a href="/service/detail?ssid=`+element.service_id+`">
                                    <img class="avatar" src="`+element.image+`"  alt=""/>
                                    <h2>`+element.name+`</h2>
                                    <p>` + element.content+`</p> </a>
                                </li>`;
                htmlDetail+=dataInfor;
            });  
            console.log(htmlDetail);         
            $(itemHtml).html(htmlDetail); 
        }
         
     
        $.ajax({
              type: 'GET',
              enctype: 'multipart/form-data',
              url: '/api/customers/services',
              data: {},
              processData: false, //prevent jQuery from automatically transforming the data into a query string
              contentType: false,
              cache: false,
              success: (data) => {
              console.log(data);
                 setFormToShow(data.result,"#info_service");
              },
              error: (e) => {
                console.log(e.responseText);
              },
        });

        
    </script>

